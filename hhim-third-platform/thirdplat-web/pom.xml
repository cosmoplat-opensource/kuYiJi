<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>third-platform</artifactId>
        <groupId>com.cosmo.hhim.thirdplat</groupId>
        <version>1.0</version>
    </parent>
    <groupId>com.cosmo.hhim.thirdplat</groupId>
    <artifactId>thirdplat-web</artifactId>
    <version>1.0</version>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>
    <properties>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>


        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.0.33</version>
        </dependency>

        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>com.cosmo.plugins</groupId>
            <artifactId>hhim-common-datasource</artifactId>
        </dependency>

        <dependency>
            <groupId>com.cosmo.plugins</groupId>
            <artifactId>hhim-common-log</artifactId>
        </dependency>



        <dependency>
            <groupId>com.cosmo.plugins</groupId>
            <artifactId>hhim-common-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.cosmo.hhim.thirdplat</groupId>
            <artifactId>thirdplat-modules-unipush</artifactId>
        </dependency>

        <dependency>
            <groupId>com.cosmo.hhim.thirdplat</groupId>
            <artifactId>thirdplat-modules-wechatmp</artifactId>
        </dependency>

        <dependency>
            <groupId>com.cosmo.hhim.thirdplat</groupId>
            <artifactId>thirdplat-modules-wechatminiapp</artifactId>
        </dependency>

        <!-- 短信服务 DTO 所在模块（SendSmsParam / SendStandardCodeSmsParam / CheckStandardCodeSmsParam） -->
        <dependency>
            <groupId>com.cosmo.hhim.thirdplat</groupId>
            <artifactId>thirdplat-api-cosmosupport</artifactId>
        </dependency>

        <!-- sms4j 短信服务（替换原 thirdplat-modules-cosmosupport + Forest 自封装层） -->

        <dependency>
            <groupId>com.cosmo.hhim.thirdplat</groupId>
            <artifactId>im-api-operation</artifactId>
        </dependency>

        <!-- sms4j 短信服务（替换 thirdplat-modules-cosmosupport 中 Forest 适配层） -->
        <dependency>
            <groupId>org.dromara.sms4j</groupId>
            <artifactId>sms4j-spring-boot-starter</artifactId>
        </dependency>
        <!-- sms4j 内置的 aliyun / tencent / huawei 三个供应商实现，本项目走自定义 cosmo Blend，无需引入。
             留 pom 不引的话 Maven 会去公司 nexus 找它们并报「not found」，所以这里直接不写。
             开源版用户如需切换到标准供应商，请取消下面相应依赖的注释：
        <dependency>
            <groupId>org.dromara.sms4j</groupId>
            <artifactId>sms4j-aliyun</artifactId>
        </dependency>
        <dependency>
            <groupId>org.dromara.sms4j</groupId>
            <artifactId>sms4j-tencent</artifactId>
        </dependency>
        <dependency>
            <groupId>org.dromara.sms4j</groupId>
            <artifactId>sms4j-huawei</artifactId>
        </dependency>
        -->

        <dependency>
            <groupId>org.quartz-scheduler</groupId>
            <artifactId>quartz</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.cosmo.hhim.thirdplat</groupId>
            <artifactId>thirdplat-modules-thirdclient</artifactId>
        </dependency>

        

        <dependency>
            <groupId>com.huaban</groupId>
            <artifactId>jieba-analysis</artifactId>
            <version>1.0.2</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
