<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cosmo.hhim.thirdplat.web.mapper.PhysicalModelMapper">
    
    <resultMap type="PhysicalModel" id="PhysicalModelResult">
        <result property="deviceCode"    column="device_code"    />
        <result property="iotCode"    column="iot_code"    />
        <result property="deviceName"    column="device_name"    />
        <result property="iotId"    column="iot_id"    />
        <result property="detectionProject"    column="detection_project"    />
        <result property="tag"    column="tag"    />
        <result property="dataType"    column="data_type"    />
        <result property="tenantCode"    column="tenant_code"    />
    </resultMap>

    <sql id="selectPhysicalModelVo">
        select device_code, iot_code, device_name, iot_id, detection_project, tag, data_type, tenant_code from physical_model
    </sql>

    <select id="selectPhysicalModelList" parameterType="PhysicalModel" resultMap="PhysicalModelResult">
        <include refid="selectPhysicalModelVo"/>
        <where>  
            <if test="deviceCode != null  and deviceCode != ''"> and device_code = #{deviceCode}</if>
            <if test="iotCode != null  and iotCode != ''"> and iot_code = #{iotCode}</if>
            <if test="deviceName != null  and deviceName != ''"> and device_name like concat('%', #{deviceName}, '%')</if>
            <if test="iotId != null  and iotId != ''"> and iot_id = #{iotId}</if>
            <if test="detectionProject != null  and detectionProject != ''"> and detection_project = #{detectionProject}</if>
            <if test="tag != null  and tag != ''"> and tag = #{tag}</if>
            <if test="dataType != null  and dataType != ''"> and data_type = #{dataType}</if>
            <if test="tenantCode != null  and tenantCode != ''"> and tenant_code = #{tenantCode}</if>
        </where>
    </select>
    
    <select id="selectPhysicalModelById" parameterType="String" resultMap="PhysicalModelResult">
        <include refid="selectPhysicalModelVo"/>
        where device_code = #{deviceCode}
    </select>
        
    <insert id="insertPhysicalModel" parameterType="PhysicalModel">
        insert into physical_model
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deviceCode != null">device_code,</if>
            <if test="iotCode != null">iot_code,</if>
            <if test="deviceName != null">device_name,</if>
            <if test="iotId != null">iot_id,</if>
            <if test="detectionProject != null">detection_project,</if>
            <if test="tag != null">tag,</if>
            <if test="dataType != null">data_type,</if>
            <if test="tenantCode != null">tenant_code,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deviceCode != null">#{deviceCode},</if>
            <if test="iotCode != null">#{iotCode},</if>
            <if test="deviceName != null">#{deviceName},</if>
            <if test="iotId != null">#{iotId},</if>
            <if test="detectionProject != null">#{detectionProject},</if>
            <if test="tag != null">#{tag},</if>
            <if test="dataType != null">#{dataType},</if>
            <if test="tenantCode != null">#{tenantCode},</if>
         </trim>
    </insert>

    <update id="updatePhysicalModel" parameterType="PhysicalModel">
        update physical_model
        <trim prefix="SET" suffixOverrides=",">
            <if test="iotCode != null">iot_code = #{iotCode},</if>
            <if test="deviceName != null">device_name = #{deviceName},</if>
            <if test="iotId != null">iot_id = #{iotId},</if>
            <if test="detectionProject != null">detection_project = #{detectionProject},</if>
            <if test="tag != null">tag = #{tag},</if>
            <if test="dataType != null">data_type = #{dataType},</if>
            <if test="tenantCode != null">tenant_code = #{tenantCode},</if>
        </trim>
        where device_code = #{deviceCode}
    </update>

    <delete id="deletePhysicalModelById" parameterType="String">
        delete from physical_model where device_code = #{deviceCode}
    </delete>

    <delete id="deletePhysicalModelByIds" parameterType="String">
        delete from physical_model where device_code in 
        <foreach item="deviceCode" collection="array" open="(" separator="," close=")">
            #{deviceCode}
        </foreach>
    </delete>
</mapper>