        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cosmo.hhim.thirdplat.web.mapper.HyzzCustomJobMapper">

    <resultMap type="com.cosmo.hhim.thirdplat.api.operation.domain.HyzzCustomJob" id="HyzzCustomJobResult">
        <result property="id" column="id"/>
        <result property="systemCode" column="system_code"/>
        <result property="taskDesc" column="task_desc"/>
        <result property="db" column="db"/>
        <result property="schema" column="schema"/>
        <result property="tenantCode" column="tenant_code"/>
        <result property="cron" column="cron"/>
        <result property="taskAdvanceTime" column="task_advance_time"/>
        <result property="taskNextTime" column="task_next_time"/>
        <result property="taskLastTime" column="task_last_time"/>
        <result property="topic" column="topic"/>
        <result property="tag" column="tag"/>
