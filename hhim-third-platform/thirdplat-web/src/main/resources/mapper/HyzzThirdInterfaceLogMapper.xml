<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cosmo.hhim.external.mapper.HyzzThirdInterfaceLogMapper">

    <resultMap type="com.cosmo.hhim.thirdplat.api.thirdclient.domain.HyzzThirdInterfaceLog" id="HyzzThirdInterfaceLogResult">
        <result property="id" column="id"/>
        <result property="requestId" column="request_id"/>
        <result property="messageKey" column="message_key"/>
        <result property="tenantCode" column="tenant_code"/>
        <result property="method" column="method"/>
        <result property="version" column="version"/>
        <result property="content" column="content"/>
        <result property="expandContent" column="expand_content"/>
        <result property="requestUrl" column="request_url"/>
        <result property="requestTime" column="request_time"/>
        <result property="responseTime" column="response_time"/>
        <result property="sendStatus" column="send_status"/>
        <result property="retryCount" column="retry_count"/>
        <result property="clientSupport" column="client_support"/>
        <result property="authInfo" column="auth_info"/>
    </resultMap>
    <resultMap type="com.cosmo.hhim.thirdplat.api.thirdclient.domain.HyzzThirdInterfaceRetry" id="HyzzThirdInterfaceRetryResult">
        <result property="id" column="id"/>
        <result property="requestId" column="request_id"/>
        <result property="messageKey" column="message_key"/>
        <result property="tenantCode" column="tenant_code"/>
        <result property="method" column="method"/>
        <result property="version" column="version"/>
        <result property="content" column="content"/>
        <result property="requestUrl" column="request_url"/>
        <result property="sendStatus" column="send_status"/>
        <result property="retryCount" column="retry_count"/>
        <result property="expandContent" column="expand_content"/>
        <result property="clientSupport" column="client_support"/>
        <result property="callback" column="callback"/>
        <result property="callbackTopic" column="callback_topic"/>
        <result property="callbackTag" column="callback_tag"/>
        <result property="authInfo" column="auth_info"/>
        <result property="requestType" column="request_type"/>
    </resultMap>

    <sql id="selectHyzzThirdInterfaceLogVo">
        select id,
               request_id,
               message_key,
               tenant_code,
               method,
               version,
               content,
               expandContent,
               request_url,
               request_time,
               response_time,
               send_status,
               retry_count
        from hyzz_third_interface_log
    </sql>

    <select id="selectByRequestId" resultType="java.lang.Integer">
        select count(*)
        from hyzz_third_interface_log
        where send_status = '1'
          and client_status = '1'
          and request_id = #{requestId}
          and client_support = #{clientSupport}
    </select>
    <select id="getTenantInfo" resultType="com.cosmo.hhim.common.core.third.ThirdInterfaceTenant">
        select id,
               app_id      as appId,
               tenant_code as tenantCode,
               sign_type   as signType,
               public_key  as publicKey,
               private_key as privateKey,
               request_url as requestUrl
        from hyzz_third_interface_tenant
        where active_flag = '1'
          AND tenant_code = #{tenantCode}
          AND client_support = #{strategy}
    </select>

    <select id="getScheduleRetryTask" resultMap="HyzzThirdInterfaceRetryResult">
        SELECT
            a.id,
            a.request_id,
            a.message_key,
            mp.tenant_code,
            a.content,
            a.retry_count,
            a.expand_content,
            mp.method,
            mp.version,
            mp.client_support,
            mp.request_type,
            mp.callback,
            mp.callback_topic,
            mp.callback_tag,
            it.auth_info,
            it.request_url
        FROM (
            SELECT @i := @i + 1 AS rownum,t.*
            FROM
                hyzz_third_interface_log t, (SELECT @i := 0) AS rownum) AS a
                 LEFT JOIN hyzz_third_interface_method_mapping mp ON a.method = mp.method
                            AND a.version = mp.version
                            AND a.tenant_code = mp.tenant_code
                            AND a.client_support = mp.client_support
                            AND mp.`status` = '1'
                 LEFT JOIN hyzz_third_interface_tenant it ON mp.interface_tenant_id = it.id
                            AND a.client_support = it.client_support
        WHERE a.send_status = 0
            <![CDATA[ AND a.client_status < 1  ]]>
                      AND a.retry_count = 3
            <![CDATA[ AND a.rownum%#{shardTotal}=#{shardIndex} ]]>
        ORDER BY
            a.id
        LIMIT 1000
    </select>

    <insert id="insertLog" parameterType="com.cosmo.hhim.thirdplat.api.thirdclient.domain.HyzzThirdInterfaceLog">
        insert into hyzz_third_interface_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            request_id,
            message_key,
            tenant_code,
            `method`,
            version,
            client_support,
            <if test="content != null">content,</if>
            <if test="expandContent != null">expand_content,</if>
            <if test="requestUrl != null">request_url,</if>
            <if test="requestTime != null">request_time,</if>
            <if test="responseTime != null">response_time,</if>
            send_status,
            client_status,
            retry_count,
            created_by,
            last_upd_by,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            #{requestId},
            #{messageKey},
            #{tenantCode},
            #{method},
            #{version},
            #{clientSupport},
            <if test="content != null">#{content},</if>
            <if test="expandContent != null">#{expandContent},</if>
            <if test="requestUrl != null">#{requestUrl},</if>
            <if test="requestTime != null">#{requestTime},</if>
            <if test="responseTime != null">#{responseTime},</if>
            #{sendStatus},
            #{clientStatus},
            #{retryCount},
            #{createdBy},
            #{lastUpdBy},
        </trim>
        ON DUPLICATE KEY UPDATE response_time = #{responseTime}, send_status = #{sendStatus}, client_status = #{clientStatus}, retry_count = #{retryCount}, last_upd_date=now()
    </insert>
    <insert id="insertDetailLog" parameterType="com.cosmo.hhim.thirdplat.api.thirdclient.domain.HyzzThirdInterfaceLogDetail">
        insert into hyzz_third_interface_log_detail
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="requestId != null">request_id,</if>
            <if test="messageId != null">message_id,</if>
            <if test="messageKey != null">message_key,</if>
            <if test="tenantCode != null">tenant_code,</if>
            <if test="method != null">`method`,</if>
            <if test="version != null">version,</if>
            <if test="clientSupport != null">client_support,</if>
            <if test="requestUrl != null">request_url,</if>
            <if test="requestTime != null">request_time,</if>
            <if test="responseTime != null">response_time,</if>
            <if test="responseBody != null">response_body,</if>
            <if test="sendStatus != null">send_status,</if>
            <if test="createdBy != null">created_by,</if>
            <if test="lastUpdBy != null">last_upd_by,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="requestId != null">#{requestId},</if>
            <if test="messageId != null">#{messageId},</if>
            <if test="messageKey != null">#{messageKey},</if>
            <if test="tenantCode != null">#{tenantCode},</if>
            <if test="method != null">#{method},</if>
            <if test="version != null">#{version},</if>
            <if test="clientSupport != null">#{clientSupport},</if>
            <if test="requestUrl != null">#{requestUrl},</if>
            <if test="requestTime != null">#{requestTime},</if>
            <if test="responseTime != null">#{responseTime},</if>
            <if test="responseBody != null">#{responseBody},</if>
            <if test="sendStatus != null">#{sendStatus},</if>
            <if test="createdBy != null">#{createdBy},</if>
            <if test="lastUpdBy != null">#{lastUpdBy},</if>
        </trim>
    </insert>
</mapper>