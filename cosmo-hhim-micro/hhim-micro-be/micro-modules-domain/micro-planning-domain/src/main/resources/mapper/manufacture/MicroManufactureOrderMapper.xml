    <select id="selectMicroManufactureOrderListByCondition" parameterType="MicroManufactureOrder" resultMap="MicroManufactureOrderResult">
        <include refid="selectMicroManufactureOrderVoFirst"/>
        <where>
            <if test="orderNo != null  and orderNo != ''"> and mmo.order_no like concat('%', #{orderNo}, '%')</if>
            <if test="owName != null  and owName != ''"> and (mc.customer_name like concat('%', #{owName}, '%') or mmo.ow_code like concat('%', #{owName}, '%')) </if>
            <if test="productName != null  and productName != ''"> and (mp.product_name like concat('%', #{productName}, '%') or mp.product_code like concat('%', #{productName}, '%')) </if>
            <if test="startDate != null ">
                <![CDATA[ and date_format(mmo.delivery_date, '%Y-%m-%d') >= date_format(#{startDate}, '%Y-%m-%d')  ]]>
            </if>
            <if test="endDate != null ">
                <![CDATA[ and date_format(mmo.delivery_date, '%Y-%m-%d') <= date_format(#{endDate}, '%Y-%m-%d')  ]]>
            </if>
            <if test="orderStatus != null  and orderStatus != ''"> and order_status = #{orderStatus}</if>
            <if test="tenantCode != null  and tenantCode != ''"> and tenant_code = #{tenantCode}</if>
            <if test="extendContent != null  and extendContent != ''"> and extend_content = #{extendContent}</if>
            <if test="orderStatusList != null and orderStatusList.size() > 0">
                and mmo.order_status in
                <foreach collection="orderStatusList" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="activeFlag != null  and activeFlag != ''"> and active_flag = #{activeFlag}</if>
            <if test="availableFlag == 1">and order_status in ('10', '20', '30')</if>
            <if test="orderWarnQueryFlag == 1">
                <![CDATA[and (DATEDIFF(date_format(mmo.delivery_date, '%Y-%m-%d'), DATE_FORMAT(CURRENT_DATE, '%Y-%m-%d')) = 1 or
                            DATE_FORMAT(mmo.delivery_date, '%Y-%m-%d') <= DATE_FORMAT(CURRENT_DATE, '%Y-%m-%d'))]]>
            </if>
            <if test="productSeq != null and productSeq != ''">
                and mmo.product_seq = #{productSeq}
            </if>
            <if test="owCode != null and owCode != ''">
                and mmo.ow_code = #{owCode}
            </if>
        </where>
        order by mmo.delivery_date desc, mmo.id desc
    </select>

