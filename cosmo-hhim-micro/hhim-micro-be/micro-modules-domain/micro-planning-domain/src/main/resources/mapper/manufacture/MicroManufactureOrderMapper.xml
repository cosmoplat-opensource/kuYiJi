    <sql id="selectMicroManufactureOrderVo">
        select id, order_no, ow_code, product_seq, plan_num, delivery_date, start_date, end_date, order_status, before_status, remark, finish_num, ng_num, close_reason, tenant_code, extend_content, created_by, created_date, last_upd_by, last_upd_date, active_flag from micro_manufacture_order
    </sql>

    <sql id="selectMicroManufactureOrderVoFirst">
        select mmo.id,
               order_no,
               ow_code,
               customer_name as ow_name,
               mmo.product_seq,
               mp.product_name,
               mp.product_code,
               mp.unit,
               plan_num,
               finish_num,
               delivery_date,
               order_status,
               before_status,
               mt.tech_code,
               mt.tech_name,
               mmo.extend_content
        from micro_manufacture_order mmo
        left join micro_product mp on mp.product_seq=mmo.product_seq
        left join micro_customer mc on mc.customer_code=mmo.ow_code
        left join micro_technology mt on mt.product_seq=mmo.product_seq AND mt.active_flag = '1' AND mt.tech_type='STANDARD'
    </sql>

