    <update id="addOrderFinishNum">
        update micro_manufacture_order
        <trim prefix="set" suffixOverrides=",">
            <trim prefix="finish_num =case" suffix="end,">
                <foreach collection="orderList" item="i" index="index">
                    <if test="i.finishNum!=null">
                        when order_no=#{i.orderNo} then finish_num + #{i.finishNum}
                    </if>
                </foreach>
            </trim>
            <trim prefix="ng_num =case" suffix="end,">
                <foreach collection="orderList" item="i" index="index">
                    <if test="i.ngNum!=null">
                        when order_no=#{i.orderNo} then ng_num + #{i.ngNum}
                    </if>
                </foreach>
            </trim>
            <if test="userId!=null and userId!=''">
                last_upd_by= #{userId},
            </if>
            last_upd_date= sysdate()
        </trim>
        where order_no in
        <foreach collection="orderList" item="i" index="index" separator="," open="(" close=")" >
            #{i.orderNo}
        </foreach>
    </update>
