<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cosmo.hhim.micro.base.domain.mapper.common.MicroFaqMapper">

    <resultMap type="com.cosmo.hhim.micro.base.domain.entity.common.MicroFaq" id="MicroFaqResult">
        <result property="id"       column="id"/>
        <result property="category" column="category"/>
        <result property="title"    column="title"/>
        <result property="content"  column="content"/>
        <result property="sort"     column="sort"/>
        <result property="status"   column="status"/>
    </resultMap>

    <sql id="selectMicroFaqVo">
        select id, category, title, content, sort, status
        from micro_faq
    </sql>

    <select id="selectByCategory" resultMap="MicroFaqResult">
        <include refid="selectMicroFaqVo"/>
        where category = #{category} and status = 1
        order by sort asc, id asc
    </select>

    <select id="selectList" parameterType="com.cosmo.hhim.micro.base.domain.entity.common.MicroFaq" resultMap="MicroFaqResult">
        <include refid="selectMicroFaqVo"/>
        <where>
            <if test="category != null and category != ''">and category = #{category}</if>
            <if test="status != null">and status = #{status}</if>
        </where>
        order by sort asc, id asc
    </select>

    <insert id="insert" parameterType="com.cosmo.hhim.micro.base.domain.entity.common.MicroFaq">
        insert into micro_faq (category, title, content, sort, status)
        values (#{category}, #{title}, #{content}, #{sort}, #{status})
    </insert>

    <update id="updateById" parameterType="com.cosmo.hhim.micro.base.domain.entity.common.MicroFaq">
        update micro_faq
        <set>
            <if test="category != null">category = #{category},</if>
            <if test="title != null">title = #{title},</if>
            <if test="content != null">content = #{content},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        where id = #{id}
    </update>
</mapper>
