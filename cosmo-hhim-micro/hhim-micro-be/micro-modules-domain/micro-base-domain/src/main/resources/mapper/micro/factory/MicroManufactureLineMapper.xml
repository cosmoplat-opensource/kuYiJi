<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cosmo.hhim.micro.base.domain.mapper.factory.MicroManufactureLineMapper">
    
    <resultMap type="MicroManufactureLine" id="MicroManufactureLineResult">
        <result property="id"    column="id"    />
        <result property="tenantCode"    column="tenant_code"    />
        <result property="mlineCode"    column="mline_code"    />
        <result property="mlineName"    column="mline_name"    />
        <result property="wshopCode"    column="wshop_code"    />
        <result property="wshopName"    column="wshop_name"    />
        <result property="remark"    column="remark"    />
        <result property="activeFlag"    column="active_flag"    />
        <result property="createdBy"    column="created_by"    />
        <result property="createdDate"    column="created_date"    />
        <result property="lastUpdBy"    column="last_upd_by"    />
        <result property="lastUpdDate"    column="last_upd_date"    />
    </resultMap>

    <sql id="selectMicroManufactureLineVo">
        select id, tenant_code,mline_code, mline_name, wshop_code, wshop_name, remark, active_flag, created_by, created_date, last_upd_by, last_upd_date from micro_manufacture_line
    </sql>

    <select id="selectMicroManufactureLineList" parameterType="MicroManufactureLine" resultMap="MicroManufactureLineResult">
        <include refid="selectMicroManufactureLineVo"/>
        <where>
            <if test="tenantCode != null  and tenantCode != ''"> and tenant_code = #{tenantCode}</if>
            <if test="mlineCode != null  and mlineCode != ''"> and mline_code = #{mlineCode}</if>
            <if test="mlineName != null  and mlineName != ''"> and mline_name like concat('%', #{mlineName}, '%')</if>
            <if test="wshopCode != null  and wshopCode != ''"> and wshop_code = #{wshopCode}</if>
            <if test="wshopName != null  and wshopName != ''"> and wshop_name like concat('%', #{wshopName}, '%')</if>
            <if test="activeFlag != null  and activeFlag != ''"> and active_flag = #{activeFlag}</if>
            <if test="createdDate != null "> and created_date = #{createdDate}</if>
            <if test="lastUpdBy != null  and lastUpdBy != ''"> and last_upd_by = #{lastUpdBy}</if>
            <if test="lastUpdDate != null "> and last_upd_date = #{lastUpdDate}</if>
            <if test="searchValue != null  and searchValue != ''"> and (mline_code like concat('%', #{searchValue}, '%') or mline_name like concat('%', #{searchValue}, '%'))</if>
        </where>
    </select>
    
    <select id="selectMicroManufactureLineById" parameterType="Long" resultMap="MicroManufactureLineResult">
        <include refid="selectMicroManufactureLineVo"/>
        where id = #{id}
    </select>
    <select id="selectMicroManufactureLineListWithoutLike" parameterType="MicroManufactureLine" resultMap="MicroManufactureLineResult">
        <include refid="selectMicroManufactureLineVo"/>
        <where>
            <if test="tenantCode != null  and tenantCode != ''"> and tenant_code = #{tenantCode}</if>
            <if test="mlineCode != null  and mlineCode != ''"> and mline_code = #{mlineCode}</if>
            <if test="mlineName != null  and mlineName != ''"> and mline_name = #{mlineName}</if>
            <if test="wshopCode != null  and wshopCode != ''"> and wshop_code = #{wshopCode}</if>
            <if test="wshopName != null  and wshopName != ''"> and wshop_name = #{wshopName}=</if>
            <if test="activeFlag != null  and activeFlag != ''"> and active_flag = #{activeFlag}</if>
            <if test="createdDate != null "> and created_date = #{createdDate}</if>
            <if test="lastUpdBy != null  and lastUpdBy != ''"> and last_upd_by = #{lastUpdBy}</if>
            <if test="lastUpdDate != null "> and last_upd_date = #{lastUpdDate}</if>
        </where>
    </select>

    <insert id="insertMicroManufactureLine" parameterType="MicroManufactureLine" useGeneratedKeys="true" keyProperty="id">
        insert into micro_manufacture_line
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="tenantCode != null and tenantCode != ''">tenant_code,</if>
            <if test="mlineCode != null and mlineCode != ''">mline_code,</if>
            <if test="mlineName != null and mlineName != ''">mline_name,</if>
            <if test="wshopCode != null and wshopCode != ''">wshop_code,</if>
            <if test="wshopName != null">wshop_name,</if>
            <if test="remark != null">remark,</if>
            <if test="activeFlag != null">active_flag,</if>
            <if test="createdBy != null and createdBy != ''">created_by,</if>
            <if test="createdDate != null">created_date,</if>
            <if test="lastUpdBy != null">last_upd_by,</if>
            <if test="lastUpdDate != null">last_upd_date,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="tenantCode != null and tenantCode != ''">#{tenantCode},</if>
            <if test="mlineCode != null and mlineCode != ''">#{mlineCode},</if>
            <if test="mlineName != null and mlineName != ''">#{mlineName},</if>
            <if test="wshopCode != null and wshopCode != ''">#{wshopCode},</if>
            <if test="wshopName != null">#{wshopName},</if>
            <if test="remark != null">#{remark},</if>
            <if test="activeFlag != null">#{activeFlag},</if>
            <if test="createdBy != null and createdBy != ''">#{createdBy},</if>
            <if test="createdDate != null">#{createdDate},</if>
            <if test="lastUpdBy != null">#{lastUpdBy},</if>
            <if test="lastUpdDate != null">#{lastUpdDate},</if>
         </trim>
    </insert>

    <update id="updateMicroManufactureLine" parameterType="MicroManufactureLine">
        update micro_manufacture_line
        <trim prefix="SET" suffixOverrides=",">
            <if test="tenantCode != null and tenantCode != ''">tenant_code = #{tenantCode},</if>
            <if test="mlineCode != null and mlineCode != ''">mline_code = #{mlineCode},</if>
            <if test="mlineName != null and mlineName != ''">mline_name = #{mlineName},</if>
            <if test="wshopCode != null and wshopCode != ''">wshop_code = #{wshopCode},</if>
            <if test="wshopName != null">wshop_name = #{wshopName},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="activeFlag != null">active_flag = #{activeFlag},</if>
            <if test="createdBy != null and createdBy != ''">created_by = #{createdBy},</if>
            <if test="createdDate != null">created_date = #{createdDate},</if>
            <if test="lastUpdBy != null">last_upd_by = #{lastUpdBy},</if>
            <if test="lastUpdDate != null">last_upd_date = #{lastUpdDate},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMicroManufactureLineById" parameterType="Long">
        delete from micro_manufacture_line where id = #{id}
    </delete>

    <update id="deleteMicroManufactureLineByIds" parameterType="String">
        update micro_manufacture_line set active_flag = '0' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <select id="selectMicroManufactureLineByWshopCodeAndLineCode" resultMap="MicroManufactureLineResult">
        <include refid="selectMicroManufactureLineVo"/>
        where mline_code = #{mlineCode} and wshop_code = #{wshopCode} and active_flag = '1'
    </select>

</mapper>