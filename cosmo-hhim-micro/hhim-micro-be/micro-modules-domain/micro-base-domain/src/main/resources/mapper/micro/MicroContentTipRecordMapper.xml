<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cosmo.hhim.micro.base.domain.mapper.common.MicroContentTipRecordMapper">

    <resultMap type="MicroContentTipRecord" id="MicroContentTipRecordResult">
        <result property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="userType" column="user_type"/>
        <result property="tipContent" column="tip_content"/>
        <result property="tipDate" column="tip_date"/>
        <result property="tipConfigId" column="tip_config_id"/>
    </resultMap>

    <sql id="selectMicroContentTipRecordVo">
        select id, user_id, user_type, tip_content, tip_date, tip_config_id
        from micro_content_tip_record
    </sql>

    <select id="selectMicroContentTipRecordList" parameterType="MicroContentTipRecordParam" resultMap="MicroContentTipRecordResult">
        <include refid="selectMicroContentTipRecordVo"/>
        <where>
            <if test="userId != null ">and user_id = #{userId}</if>
            <if test="userType != null ">and user_type = #{userType}</if>
            <if test="tipConfigId != null ">and tip_config_id = #{tipConfigId}</if>
            <if test="startDate != null ">and tip_date &gt;= #{startDate}</if>
            <if test="endDate != null ">and tip_date &lt; #{endDate}</if>
        </where>
    </select>

    <select id="selectLastMicroContentTipRecord" resultMap="MicroContentTipRecordResult">
        <include refid="selectMicroContentTipRecordVo"/>
        where user_id = #{userId}
        and user_type = #{userType}
        and tip_config_id = #{tipConfigId}
        order by tip_date desc limit 1
    </select>

    <insert id="insertMicroContentTipRecord" parameterType="MicroContentTipRecord" useGeneratedKeys="true" keyProperty="id">
        insert into micro_content_tip_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="userType != null">user_type,</if>
            <if test="tipContent != null">tip_content,</if>
            <if test="tipDate != null">tip_date,</if>
            <if test="tipConfigId != null">tip_config_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="userType != null">#{userType},</if>
            <if test="tipContent != null">#{tipContent},</if>
            <if test="tipDate != null">#{tipDate},</if>
            <if test="tipConfigId != null">#{tipConfigId},</if>
        </trim>
    </insert>

    <update id="updateMicroContentTipRecord" parameterType="MicroContentTipRecord">
        update micro_content_tip_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userType != null">user_type = #{userType},</if>
            <if test="tipContent != null">tip_content = #{tipContent},</if>
            <if test="tipDate != null">tip_date = #{tipDate},</if>
            <if test="tipConfigId != null">tip_config_id = #{tipConfigId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMicroContentTipRecordById" parameterType="Long">
        delete
        from micro_content_tip_record
        where id = #{id}
    </delete>

    <delete id="deleteMicroContentTipRecordByIds" parameterType="String">
        delete from micro_content_tip_record where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>