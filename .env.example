# ============================================================
# cosmo-hhim 部署配置示例
# 使用：cp .env.example .env 后按需修改，.env 不要提交到 git
# ============================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=im_micro
# 应用连接（compose 内部默认指向 mysql 容器，一般不用改）
DB_HOST=mysql
DB_PORT=3306
DB_NAME=im_micro
DB_USERNAME=root
DB_PASSWORD=change_me_root_password
DB1_HOST=mysql
DB1_PORT=3306
DB1_NAME=im_micro
DB1_USERNAME=root
DB1_PASSWORD=change_me_root_password
# 后端② hhim-third-platform 专用库（db0 = im-portal 库，hyzz_* 三方对接表）
# 该库由 hyzz-schema.sql 在 mysql 首次初始化时自动创建，一般不用改
THIRDPLAT_DB_HOST=mysql
THIRDPLAT_DB_PORT=3306
THIRDPLAT_DB_NAME=im-portal
THIRDPLAT_DB_USERNAME=root
# 留空则跟随 MYSQL_ROOT_PASSWORD（两个库在同一 mysql 容器，密码一致）
THIRDPLAT_DB_PASSWORD=

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
# 留空表示无密码（compose 内 redis 默认无密码）
# ⚠️ 如设置密码，必须同步给 docker-compose.yml 的 redis 服务配置 requirepass，否则应用 AUTH 失败
REDIS_PASSWORD=

# ---------- MinIO（对象存储，替代 ioss） ----------
# 容器内互访地址（后端直接用，无需改）。
# ⚠️ 如需浏览器回显上传的图片：必须改为宿主机可达地址（如 http://<宿主机IP>:9000，
#    compose 已把 9000 映射到宿主机），否则前端拿到 http://minio:9000/... 解析不了容器名。
# 桶（hhim / hhim-micro / hyzz-site-test）由 minio-init 服务首次启动自动创建，无需手动建。
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hhim
MINIO_MICRO_BUCKET=hhim-micro

# ---------- JWT 密钥 ----------
# 生产环境务必改成随机长字符串（至少 32 位）
JWT_SECRET=please_set_jwt_secret_at_least_32_chars

# ---------- Feign（微服务间直连） ----------
# compose 内部用服务名，一般不用改
FEIGNDEBUG_THIRDPLATURL=http://hhim-third-platform:8899

# ---------- 意见反馈详情页（可选，飞书机器人消息附带） ----------
FEEDBACK_DETAIL_URL=

# ---------- 短信网关（后端② hhim-third-platform） ----------
COSMO_SMS_ACCESS_KEY=
COSMO_SMS_URL=
COSMO_SMS_TEMPLATE=
# 登录验证码 / 周报短信模板 ID
SMS_LOGIN_CODE=
SMS_WEEK_REPORT=
# 后端① micro-be 短信模板 ID（Feign 传给后端②的 tempId；与上面 SMS_LOGIN_CODE/SMS_WEEK_REPORT 保持一致）
SMS_URL=
SMS_WEEK_TEMPLATE=
SMS_LOGIN_TEMPLATE=

# ---------- 待办推送（可选，按需配置） ----------
TODOPUSH_APP_ID=
TODOPUSH_APP_SECRET=
TODOPUSH_GATEWAY_URL=
TODOPUSH_PARENT_ID=0

# ---------- 系统平台 / 业务默认值（可选，按需配置） ----------
SYS_URL=
ORIGINAL_CUSTOMER_CODE=
APPLICATION_PRODUCT_ID=
IMPORTEXPORT_IMPORT_LINK=

# ---------- uni-push 个推推送（可选，按需配置） ----------
UNIPUSH_APP_ID=
UNIPUSH_APP_KEY=
UNIPUSH_APP_SECRET=
UNIPUSH_MASTER_SECRET=
UNIPUSH_APP_PACKAGE=
UNIPUSH_BASE_URL=

# ---------- 微信公众号（可选，按需配置） ----------
WXMP_APP_ID=
WXMP_APP_SECRET=
WXMP_SERVER_TOKEN=
WXNO_SERVER_AES_KEY=

# ---------- 海尔 SQM 开放平台（可选，按需配置） ----------
# 卡奥斯 IoT 平台地址 / 海尔 SQM 开放平台地址
COSMO_IOT_URL=https://your-iot-platform.com
COSMO_SQM_URL=https://your-sqm-platform.com
SQM_CLIENT_ID=
SQM_CLIENT_SECRET=

# ---------- Nacos（可选，当前未使用） ----------
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# ---------- H5 前端 ----------
# 宿主机映射端口（服务器要求 8080 时改这里）
H5_PORT=80
# /api 由 nginx 反代到后端①，一般不用改
VITE_API_BASE=/api
# 体验登录固定账号（H5 构建时注入；小程序在微信开发者工具构建时自行配置，默认 15888888888/cosmoplat）
VITE_EXPERIENCE_USERNAME=15888888888
VITE_EXPERIENCE_PASSWORD=cosmoplat

# ---------- 小程序端构建变量（构建小程序时使用；compose 的 H5 构建不使用） ----------
# 小程序端后端地址（留空默认 http://localhost:9010，仅微信开发者工具本地调试；
# 真机预览/体验版需改为公网可达 https 域名并在微信公众平台配置 request 合法域名）
VITE_MP_API_BASE=
# 小程序端静态资源地址（视频/图片，指向已部署的 H5 静态目录，如 https://your-domain.com/static/micro_app）
VITE_MP_VIDEO_BASE=
# 小程序跳转目标 AppID（占位；本地开发可在 .env.development.local 配置真实值，该文件已 gitignore）
VITE_MP_TARGET_APPID=wx0000000000000000
